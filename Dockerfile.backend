FROM python:3.12-slim

WORKDIR /app/server

COPY server/pyproject.toml ./
COPY server/eco ./eco
COPY server/tools ./tools

RUN pip install --no-cache-dir .

RUN mkdir -p /app/server/data /app/server/backups

EXPOSE 8000

CMD ["uvicorn", "eco.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
