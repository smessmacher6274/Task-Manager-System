# Copy to server/.env (gitignored). Values for the LOCAL docker stack only.
REDMINE_URL=http://127.0.0.1:3000
OUTBOX_DRY_RUN=true

# Per-user Redmine API keys (never stored in the DB). From infra/redmine/seed.rb output.
REDMINE_KEY_USER_1=
# Integration tests: "me" and "coworker" keys from the seed output.
REDMINE_KEY_ME=
REDMINE_KEY_COWORKER=

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=server
MQTT_PASSWORD=server-pass
SIM_DEVICE_PASSWORD=sim-device-pass

# Existing 2040Bluetooth pad (one device per broker). Set true to enable.
PAD_ENABLED=false
PAD_USER_ID=1
PAD_DB=personal

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
ALERT_EMAIL=

# To test the scheduler, make jobs fire soon, e.g. every minute:
# JOB_REMINDER_CRON=* * * * *
# JOB_PUSH_CRON=* * * * *
